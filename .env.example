# ─────────────────────────────────────────────────────────────────────────────
# Musebook — environment template.  GENERATED by scripts/gen-env-example.mjs
# from scripts/env-manifest.mjs (plan section 3.7).  Do not edit by hand.
# Copy to .env.local and fill in.  Nothing prefixed NEXT_PUBLIC_ may be secret
# (the build inlines it into the client bundle).
# ─────────────────────────────────────────────────────────────────────────────

# ── Application and the Vercel seam ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# The origin lockdown. <project>.vercel.app stays publicly reachable; proxy.ts 404s anything without this header (CF-SPINE 1.4).
MUSEBOOK_EDGE_SECRET=""
MUSEBOOK_EDGE_SECRET_PREVIOUS=""
# toOrigin() rebuilds on ORIGIN_SCHEME://ORIGIN_HOST. Only the local dev pair sets http (wrangler dev → next start); deployed envs keep https.
ORIGIN_SCHEME="https"
CDN_HOST="cdn.musebook.dev"
ARTIFACT_ORIGIN="https://artifacts.musebook.dev"
MUSEBOOK_LOG_LEVEL="info"
# CI-injected via `wrangler deploy --var`. Not in wrangler.jsonc.
MB_RELEASE_SHA=""
PREVIEW_CHARS="400"
LANDING_DEMO_SOURCE="auto"
NEXT_PUBLIC_LANDING_TESTIMONIALS="false"
NEXT_PUBLIC_LANDING_PROOF="false"
# Region comes from request.cf.country, forwarded as x-mb-country — x-vercel-ip-country is dead behind Cloudflare.
CONSENT_BANNER_REGIONS=""
SECURITY_CONTACT_EMAIL=""
PRIVACY_CONTACT_EMAIL=""

# ── Cloudflare platform ───────────────────────────────────────────────────────
# The deploy token: Workers Scripts:Edit, R2:Edit, Queues:Edit, KV:Edit + zone Cache Purge. Never Global API Key.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID="e8f42c0430906e1515a2af01d5c1d2d1"
CF_ACCOUNT_ID="e8f42c0430906e1515a2af01d5c1d2d1"
CF_ZONE_ID=""
# Read-only + zone-settings scope for the AE SQL API and configure-cf.ts. NEVER the deploy token.
CF_API_TOKEN=""
# Write-only on musebook-logs alone. Distinct from R2_ACCESS_KEY_ID.
R2_LOGPUSH_ACCESS_KEY_ID=""
R2_LOGPUSH_SECRET_ACCESS_KEY=""

# ── Supabase (project musebook-prod — NOT the legacy shared project) ──────────
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Vercel only. A Worker reaches Postgres through Hyperdrive as musebook_worker, never through PostgREST.
SUPABASE_SECRET_KEY=""
# Direct, port 5432 — migrations, pg_partman, pgTAP. NO runtime component reads this.
SUPABASE_DB_URL=""
# Only to create or rotate a Hyperdrive config. Never at runtime.
MUSEBOOK_WORKER_DB_PASSWORD=""
SUPABASE_JWT_SECRET=""
SUPABASE_PROJECT_REF="rmcgtcsfrfrjxeyxoiin"
# preview-db.yml creates/resets/deletes Supabase branches with it.
SUPABASE_ACCESS_TOKEN=""
SUPABASE_DB_PASSWORD=""

# ── thirdweb (identity) and Moltbook ──────────────────────────────────────────
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=""
NEXT_PUBLIC_THIRDWEB_AUTH_DOMAIN="localhost:3000"
THIRDWEB_SECRET_KEY=""
# Never on a Worker.
THIRDWEB_ADMIN_PRIVATE_KEY=""
# Outbound payout wallet. Never the inbound payTo — that is X402_PAY_TO.
THIRDWEB_SERVER_WALLET_ADDRESS=""
MOLTBOOK_MODE="production"
MOLTBOOK_ALLOW_MOCK="false"

# ── x402, settlement and payouts ──────────────────────────────────────────────
X402_MODE="shadow"
X402_NETWORK="eip155:84532"
X402_CHAIN_ID="84532"
X402_RPC_URL=""
X402_ASSET_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
# Base mainnet USDC is 'USD Coin', Sepolia is 'USDC'. A wrong pair makes every gated route unpayable.
X402_ASSET_EIP712_NAME="USDC"
X402_ASSET_DECIMALS="6"
X402_FACILITATOR_URL="https://api.cdp.coinbase.com/platform/v2/x402"
X402_IDEMPOTENT_WINDOW_SECONDS="120"
# Base Sepolia payer key — the live-facilitator gate tier (m8-wire, packages/x402/test/live) only. Never a Worker binding.
X402_TEST_PAYER_KEY=""

# ── Typesafe / Jev (classification) and LLM generation ────────────────────────
# TypeSafeClient throws in its CONSTRUCTOR — construct lazily inside the consumer or the deploy fails.
TYPESAFE_API_KEY=""
TYPESAFE_BASE_URL="https://api.typesafe.ai"
TYPESAFE_DEFAULT_MODEL="jev-latest"
# Never debug in a deployed environment — it logs full request/response bodies.
TYPESAFE_LOG_LEVEL="warn"
CLASSIFY_TAXONOMY_MODE="walk"

# ── Postiz (distribution) ─────────────────────────────────────────────────────
# API base is ${POSTIZ_URL}/api/public/v1 — the bundled nginx proxies /api/ to the backend.
POSTIZ_URL="http://localhost:4200"

# ── Media generation, artifacts and storage ───────────────────────────────────
MEDIA_SANDBOX_IMAGE="vercel/sandbox/node:24"
C2PA_SIGNING_ENABLED="false"
C2PA_SIGNING_CERT_PEM=""
C2PA_SIGNING_KEY_PEM=""
C2PA_TSA_URL=""

# ── MCP server, OAuth and WebMCP ──────────────────────────────────────────────
# musebook CLI — remote MCP endpoint. Not a Worker binding.
MUSEBOOK_MCP_URL="https://mcp.musebook.dev/mcp"
# musebook CLI — OAuth access token for the remote MCP.
MUSEBOOK_TOKEN=""
NEXT_PUBLIC_WEBMCP_OT_TOKEN=""
WEBMCP_BRIDGE_ENABLED="false"

# ── Internal calls between Vercel and Cloudflare ──────────────────────────────
# Ed25519 PKCS#8 DER, base64. Signs the Worker→Vercel sandbox/C2PA calls.
MB_INTERNAL_SIGNING_KEY=""
MB_INTERNAL_KEY_ID=""
# JSON map keyid → base64 SPKI; holds current AND previous during rotation.
MB_INTERNAL_PUBLIC_KEYS=""
MB_INTERNAL_MAX_SKEW_S="300"

# ── Muse-mixer (ranking) and embeddings ───────────────────────────────────────
MUSE_WEIGHTS_VERSION="none"
MUSE_RANKER_IMPL="heuristic"
MUSE_RANKER_MODEL_ID="muse-heuristic-2026-10"
MUSE_RANKER_ONNX_PATH=""
MUSE_RANKER_MODEL_URL=""
MUSE_DIVERSITY_IMPL="none"
MUSE_RANKER_TIMEOUT_MS="250"
MUSE_RETRIEVAL_NEW_USER_ACTION_THRESHOLD="20"
MUSE_RETRIEVAL_NEW_USER_INDEX_ID="cohort-centroid"
MUSE_RANKER_NEW_USER_ACTION_THRESHOLD="50"
MUSE_TOPK_CANDIDATES="100"
MUSE_MAX_CANDIDATES_PER_SOURCE="400"
MUSE_MIN_CANDIDATES="30"
MUSE_SOURCE_TIMEOUT_MS="180"
MUSE_HYDRATOR_TIMEOUT_MS="150"
MUSE_SCORER_TIMEOUT_MS="250"
MUSE_SLATE_TTL_SECONDS="900"
MUSE_SCORE_CACHE_TTL_SECONDS="600"
MUSE_WEIGHTS_CACHE_TTL_SECONDS="30"
MUSE_HNSW_EF_SEARCH="200"
MUSE_BLOOM_CAPACITY="10000"
MUSE_BLOOM_ERROR_RATE="0.01"
MUSE_BLOOM_ROTATION="weekly"
MUSE_BLOOM_BYPASS_REMOVAL_RATIO="0.70"
MUSE_SEEN_EXACT_WINDOW="500"
MUSE_AGENT_CRAWL_MAX_PER_POST_PER_AGENT_PER_DAY="3"
MUSE_COLDSTART_ENABLED="true"
MUSE_COLDSTART_FOLLOWER_CAP="5000"
MUSE_COLDSTART_IMPRESSION_THRESHOLD="1000"
MUSE_COLDSTART_MAX_POST_AGE_MS="172800000"
MUSE_COLDSTART_MAX_POSITION_RATIO="0.5"
MUSE_COLDSTART_SLOT_MIN="3"
MUSE_COLDSTART_SLOT_MAX="12"
MUSE_COLDSTART_BETA_ALPHA0="1.0"
MUSE_COLDSTART_BETA_BETA0="1.0"
MUSE_COLDSTART_IMPRESSION_SCALE="1.0"
MUSE_COLDSTART_TS_TOP_K="5"
MUSE_VIEWER_EMBED_INTERVAL_H="24"
OUTBOX_SWEEP_MAX_ROWS="500"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS="1536"

# ── Telemetry and analytics ───────────────────────────────────────────────────
TELEMETRY_IDLE_FLUSH_MS="5000"

# ── Observability and alerting ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ── CI-only, run-once, and platform-injected ──────────────────────────────────
# Target for §17.9's MCP conformance run. On the ignore list.
MCP_TEST_URL=""
TURBO_TOKEN=""
TURBO_TEAM=""
NEXT_TELEMETRY_DISABLED="1"
# vercel deploy / vercel env. Never set on a deployment.
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID_WEB=""
# Platform-injected: production | preview | development.
VERCEL_ENV=""
# Platform-injected. Not available in a Worker — that is MB_RELEASE_SHA.
VERCEL_GIT_COMMIT_SHA=""
# Platform-injected for @vercel/sandbox. Nothing to set by hand.
VERCEL_OIDC_TOKEN=""
