# deps / build
node_modules/
dist/
.turbo/
*.tsbuildinfo

# apps
.next/
out/
.vercel/
.wrangler/

# generated Worker types are COMMITTED (not ignored) — CI regenerates and diffs them.

# env / secrets
.env
.env.*
!.env.example
.dev.vars
!.dev.vars.example

# test output
coverage/
reports/
playwright-report/
test-results/

