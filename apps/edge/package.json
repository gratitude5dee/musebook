{
  "name": "musebook-edge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build": "tsc --build --pretty",
    "typecheck": "tsc --build --pretty",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "cf:dry": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@musebook/connectors": "workspace:*",
    "@musebook/kernel": "workspace:*",
    "@musebook/schema": "workspace:*",
    "@musebook/telemetry": "workspace:*",
    "@musebook/x402": "workspace:*",
    "aws4fetch": "1.0.20",
    "pg": "catalog:",
    "web-bot-auth": "0.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "26.6.2",
    "@types/pg": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "postgres": "3.4.7",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
