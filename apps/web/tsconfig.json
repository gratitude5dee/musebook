{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "rootDir": ".",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.tsx", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next", "coverage", ".wrangler"],
  "references": [{ "path": "../../packages/schema" }, { "path": "../../packages/ui" }]
}
