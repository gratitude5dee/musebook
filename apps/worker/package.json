{
  "name": "musebook-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8789",
    "build": "tsc --build --pretty",
    "typecheck": "tsc --build --pretty",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "cf:dry": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@musebook/schema": "workspace:*",
    "@musebook/muse-mixer": "workspace:*",
    "@musebook/distributor": "workspace:*",
    "@musebook/classify": "workspace:*",
    "@musebook/media": "workspace:*",
    "@musebook/connectors": "workspace:*",
    "@musebook/artifacts": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
