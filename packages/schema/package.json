{
  "name": "@musebook/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./actor": "./src/actor.ts",
    "./constants": "./src/constants.ts",
    "./kernel": "./src/kernel.ts",
    "./surface": "./src/surface.ts",
    "./telemetry": "./src/telemetry.ts",
    "./internal-signature": "./src/internal-signature.ts"
  },
  "scripts": {
